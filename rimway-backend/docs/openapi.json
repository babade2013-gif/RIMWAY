  "info": {
    "title": "RIM WAY API",
    "description": "The RIM WAY Backend API Contract for Passenger and Driver Apps",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "SendOtpDto": {
        "type": "object",
        "properties": {}
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {}
      },
      "EstimateFareDto": {
        "type": "object",
        "properties": {
          "pickupLat": {
            "type": "number"
          },
          "pickupLng": {
            "type": "number"
          },
          "dropoffLat": {
            "type": "number"
          },
          "dropoffLng": {
            "type": "number"
          },
          "serviceTypeId": {
            "type": "string"
          }
        },
        "required": [
          "pickupLat",
          "pickupLng",
          "dropoffLat",
          "dropoffLng",
          "serviceTypeId"
        ]
      },
      "RequestRideDto": {
        "type": "object",
        "properties": {
          "pickupLat": {
            "type": "number"
          },
          "pickupLng": {
            "type": "number"
          },
          "dropoffLat": {
            "type": "number"
          },
          "dropoffLng": {
            "type": "number"
          },
          "serviceTypeId": {
            "type": "string"
          },
          "pickupName": {
            "type": "string"
          },
          "dropoffName": {
            "type": "string"
          }
        },
        "required": [
          "pickupLat",
          "pickupLng",
          "dropoffLat",
          "dropoffLng",
          "serviceTypeId",
          "pickupName",
          "dropoffName"
        ]
      },
      "CancelRideDto": {
        "type": "object",
        "properties": {
          "rideId": {
            "type": "string"
          }
        },
        "required": [
          "rideId"
        ]
      },
      "RegistrationVehicleDto": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "number",
            "minimum": 1990,
            "maximum": 2035
          },
          "color": {
            "type": "string"
          },
          "plateNumber": {
            "type": "string"
          },
          "serviceTypeId": {
            "type": "string"
          }
        },
        "required": [
          "brand",
          "model",
          "year",
          "color",
          "plateNumber",
          "serviceTypeId"
        ]
      },
      "RegistrationFileDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "fileUrl": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "fileUrl",
          "fileName",
          "mimeType"
        ]
      },
      "DriverRegistrationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/RegistrationVehicleDto"
          },
          "documents": {
            "minItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationFileDto"
            }
          },
          "vehiclePhotos": {
            "minItems": 4,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationFileDto"
            }
          }
        },
        "required": [
          "name",
          "vehicle",
          "documents",
          "vehiclePhotos"
        ]
      },
      "DriverStatusDto": {
        "type": "object",
        "properties": {
          "isOnline": {
            "type": "boolean"
          }
        },
        "required": [
          "isOnline"
        ]
      },
      "DriverLocationDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "CreatePhoneRideDto": {
        "type": "object",
        "properties": {
          "pickupLat": {
            "type": "number"
          },
          "pickupLng": {
            "type": "number"
          },
          "dropoffLat": {
            "type": "number"
          },
          "dropoffLng": {
            "type": "number"
          },
          "serviceTypeId": {
            "type": "string"
          },
          "pickupName": {
            "type": "string"
          },
          "dropoffName": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "customerPhone": {
            "type": "string"
          },
          "estimatedFare": {
            "type": "number"
          },
          "distanceKm": {
            "type": "number"
          }
        },
        "required": [
          "pickupLat",
          "pickupLng",
          "dropoffLat",
          "dropoffLng",
          "serviceTypeId",
          "pickupName",
          "dropoffName",
          "customerName",
          "customerPhone"
        ]
      },
      "AdminCancelRideDto": {
        "type": "object",
        "properties": {
          "stateVersion": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "stateVersion"
        ]
      },
      "VehicleDto": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "plateNumber": {
            "type": "string"
          },
          "serviceTypeId": {
            "type": "string"
          }
        },
        "required": [
          "brand",
          "model",
          "year",
          "color",
          "plateNumber",
          "serviceTypeId"
        ]
      },
      "AdminDocumentInputDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "fileUrl": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "fileUrl",
          "fileName",
          "mimeType"
        ]
      },
      "CreateCaptainDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+222[2-4][0-9]{7}$"
          },
          "name": {
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/VehicleDto"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminDocumentInputDto"
            }
          },
          "vehiclePhotos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminDocumentInputDto"
            }
          }
        },
        "required": [
          "phone"
        ]
      },
      "UpdateCaptainDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ActionReasonDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}